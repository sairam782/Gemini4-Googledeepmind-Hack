# Copy to .env and fill in. Never commit .env or paste these values anywhere.

# SignalWire (Dashboard → API Credentials)
SIGNALWIRE_SPACE_URL=unorevoice.signalwire.com
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_NUMBER=+12084850663
# Only needed when VALIDATE_SIGNATURE=true (Dashboard → API Credentials → Signing Key)
SIGNALWIRE_SIGNING_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_FAST_MODEL=gemini-4-hydrogen
GEMINI_CHECK_MODEL=gemini-4-neon

# Name the agent uses for the phone's owner
OWNER_NAME=Alex

# ngrok host, without https://  (e.g. abcd.ngrok-free.app)
PUBLIC_HOST=
PORT=3000
VALIDATE_SIGNATURE=false
