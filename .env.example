# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=

# One model per lane (README diagram). Swap here without code changes.
# fast lane: instant tailored directions
FLASH_MODEL=gemini-3.5-flash-lite
# warning signs on the newest caller line
RISK_MODEL=gemini-4-hydrogen
# facts, corrections, open decision
NOTES_MODEL=gemini-4-hydrogen
# next 3 directions with exact words
PLANNER_MODEL=gemini-4-argon
# confirms/removes signs, vetoes unsafe directions
SUPERVISOR_MODEL=gemini-4-neon
# after hang-up: summary, verdict, follow-ups
REVIEW_MODEL=gemini-4-carbon
# review phase: grades each call and writes lessons for the next one (gemini-4-carbon for the deepest review)
CRITIC_MODEL=gemini-4-neon
# CRITIC_THINKING=high
# simulated callers in scripts/learn.ts
SIM_CALLER_MODEL=gemini-4-hydrogen
# LEARN=0 turns off the playbook and the critic
TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore
# Thinking per lane: low | high | none (none = send no thinking config)
# PLANNER_THINKING=low

# Phone (Twilio)
# e.g. abcd.ngrok.app, used in the TwiML stream URL
PUBLIC_HOST=
# comma-separated numbers treated as "in Alex's contacts"
CONTACTS=

API_PORT=8787

# Learning storage
# Optional. Use the Supabase Postgres Session pooler URI from the Connect panel.
# Omit this variable to use JSON files under server/data/learning.
SUPABASE_DB_URL=
